FROM python:3.11-slim-bookworm AS base

RUN groupadd --system --gid 10002 sensel-worker \
    && useradd --system --uid 10002 --gid sensel-worker --home /nonexistent sensel-worker

WORKDIR /app

COPY services/sensel-site/requirements.txt ./requirements.txt
COPY services/sensel-site/requirements-trainer.txt ./requirements-trainer.txt
RUN pip install --no-cache-dir -r requirements-trainer.txt

COPY services/sensel-site/sensel_site/ ./sensel_site/
COPY services/sensel-edge-agent/sensel/ ./sensel/
COPY config/model/feature-contract.*.json ./contracts/
COPY config/model/trainer-policy.*.json ./policies/

RUN mkdir -p \
        /input/trainer-inbox /input/candidates \
        /input/validation \
        /output/candidates /output/validation /output/conversion /output/approval-bundles \
    && chown 10001:10001 /input/trainer-inbox \
    && chown -R sensel-worker:sensel-worker /input/candidates /output \
    && chmod 0755 \
        /input/trainer-inbox /input/candidates /input/validation \
        /output/candidates /output/validation /output/conversion /output/approval-bundles

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

USER 10002:10002

FROM base AS test

USER root
RUN pip install --no-cache-dir pytest==8.4.2
USER 10002:10002

FROM base AS runtime

CMD ["python", "-m", "sensel_site.xgboost_trainer"]
