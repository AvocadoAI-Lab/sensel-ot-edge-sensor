FROM python:3.11-slim-bookworm

ARG FLOWER_VERSION=1.33.0

RUN groupadd --gid 49999 flower \
    && useradd --uid 49999 --gid flower --create-home --home-dir /app flower \
    && mkdir -p /app/.flwr \
    && chown -R 49999:49999 /app

RUN python -m pip install --no-cache-dir \
    "flwr==${FLOWER_VERSION}" \
    "numpy==2.4.6" \
    "xgboost-cpu==3.1.3"

USER 49999:49999
WORKDIR /app
ENTRYPOINT ["flower-supernode"]
