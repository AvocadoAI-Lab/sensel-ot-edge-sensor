# =============================================================================
# SenseL OT Edge Sensor — Environment Variables
# Copy to .env and fill in values before deployment
# =============================================================================

# --- Identity ---
SITE_ID=factory-lab-001
# 留空或 ot-edge-001 時，自動依主機名稱產生 ot-edge-<hostname>（每台唯一）
# SENSOR_ID=ot-edge-001
SENSOR_ID=
SENSOR_TYPE=ot-edge-sensor

# --- SenseL Platform ---
SENSEL_API_URL=https://your-sensel-instance.example.com
SENSEL_API_KEY=your-api-key-here
# Portal registration retry interval when 108 is late (seconds)
REGISTER_RETRY_SEC=60
# Optional: use MQTT bridge instead of HTTPS for telemetry
SENSEL_MQTT_URL=
SENSEL_MQTT_TLS=true

# --- Network Interfaces ---
# Management NIC (SenseL uplink, EdgeX management)
MGMT_INTERFACE=eth0
# Mirror/SPAN capture NIC (promiscuous mode)
CAPTURE_INTERFACE=eth1

# --- IEC 61850 lab publishers (host network, ARM OK) ---
GOOSE_INTERFACE=eth0
MMS_INTERFACE=eth0
MMS_SRC_IP=192.168.10.88
MMS_DST_IP=192.168.10.50
MMS_INTERVAL_SEC=2

# --- Packet Capture ---
# Lab 61850 example:
# CAPTURE_BPF_FILTER=(ether proto 0x88b8) or (tcp port 102)
CAPTURE_BPF_FILTER=
# Track A: AF_XDP capture backend (scapy | af_xdp)
CAPTURE_BACKEND=scapy
# XDP_MODE=native
# XDP_QUEUE_ID=0
# AF_XDP_FRAME_SIZE=2048
# AF_XDP_NUM_FRAMES=4096
PCAP_RETENTION_MINUTES=120
PCAP_MAX_DISK_MB=2048
PCAP_EVIDENCE_BEFORE_SEC=60
PCAP_EVIDENCE_AFTER_SEC=60

# --- Feature Summary ---
FEATURE_WINDOW_SEC=60

# --- EdgeX (4.0.0, non-secure MVP stack) ---
# Internal message bus broker (EdgeX services)
EDGEX_MQTT_BROKER=edgex-mqtt-broker
EDGEX_MQTT_PORT=1883
# P2-A device inventory / reconciliation via EdgeX Core Metadata
EDGEX_CORE_METADATA_URL=http://edgex-core-metadata:59881
EDGEX_DEVICE_MANAGEMENT_ENABLED=true
EDGEX_INVENTORY_INTERVAL_SEC=60
EDGEX_DESIRED_MQTT_ENABLED=true
# Lab UI: docker compose --profile lab-ui up -d  →  http://127.0.0.1:4000

# --- Local MQTT (feature summary bridge → EdgeX device-mqtt) ---
LOCAL_MQTT_HOST=local-mqtt
LOCAL_MQTT_PORT=1883
EDGEX_FEATURE_DEVICE_NAME=packet-sensor-features
# Leave empty for EdgeX 4 multi-level default: incoming/data/packet-sensor-features/FeatureSummary
EDGEX_FEATURE_DATA_TOPIC=

# --- Control Plane MQTT (northbound — primary event uplink) ---
NORTHBOUND_MQTT_ENABLED=true
CONTROL_PLANE_MQTT_HOST=192.168.1.203
CONTROL_PLANE_MQTT_PORT=1883
MQTT_TENANT_ID=default

# --- Track B: CTI policy sync (edge-agent) + IoC match (packet-sensor) ---
POLICY_SYNC_ENABLED=true
POLICY_SYNC_INTERVAL_SEC=60
# Portal「情資 API Key」— 勿提交至 git
SMB_INTEL_API_KEY=
# 若 API Key 綁定平台 tenant、與 Pi 註冊 tenant 不同，可覆寫 feed tenant
# 例：POLICY_SYNC_TENANT_ID=sensel-platform
POLICY_SYNC_TENANT_ID=
IOC_MATCH_ENABLED=true
IOC_MATCH_COOLDOWN_SEC=300
IOC_CACHE_RELOAD_SEC=5
SIGHTING_REPORT_ENABLED=true
SIGHTING_REPORT_INTERVAL_SEC=10
# Phase 2: MQTT blacklist push (Track B-S5) — same broker as northbound by default
POLICY_SYNC_MQTT_ENABLED=false
# POLICY_SYNC_MQTT_HOST=192.168.1.203
# POLICY_SYNC_MQTT_TOPIC=sensel/{tenant_id}/policy/blacklist
# 快取／佇列路徑由 docker-compose 依服務掛載設定（host 皆為 data/agent/）

# --- Policy (legacy) ---
POLICY_VERSION=2026.05.30.001

# --- Logging ---
LOG_LEVEL=info

# --- Hardware profile (ubuntu | pi4) ---
DEPLOY_TARGET=ubuntu
# P3-D model rollout manager (one-shot profile, disabled by default)
SENSEL_SITE_TENANT_ID=tenant-a
SENSEL_SITE_ID=site-a
SENSEL_SENSOR_ID=edge-a
SENSEL_DISTRIBUTION_SIGNING_KEY_ID=control-plane-model-ed25519-2026-01
SENSEL_RELEASE_SIGNING_KEY_ID=site-a-release-ed25519-2026-01
SENSEL_EDGE_REPORT_SIGNING_KEY_ID=edge-a-report-key-1
SENSEL_MODEL_PUBLIC_KEY_DIR=./secrets/model-public
SENSEL_EDGE_REPORT_SIGNING_KEY_FILE=./secrets/edge-report/signing-key.pem
SENSEL_MODEL_BUNDLE_DIR=./data/model-rollout/inbox

# P4-B production Flower SuperNode (docker-compose.federation.yml)
SENSEL_FLOWER_CONTROL_PLANE_HOST=fl.example.internal
SENSEL_FLOWER_CONTROL_PLANE_PORT=9442
SENSEL_FLOWER_LOCAL_TLS_DIR=./secrets/flower/local-tls
SENSEL_FLOWER_SITE_MTLS_DIR=./secrets/flower/site-mtls
SENSEL_FLOWER_APPIO_TLS_DIR=./secrets/flower/appio-tls
SENSEL_FLOWER_SUPERNODE_AUTH_DIR=./secrets/flower/supernode-auth

# P5 Site production storage and recovery objectives
SENSEL_SITE_MAX_DATABASE_BYTES=10737418240
SENSEL_SITE_MAX_WAL_BYTES=536870912
SENSEL_SITE_BACKUP_INTERVAL_SECONDS=86400
SENSEL_SITE_BACKUP_RETENTION_DAYS=30
