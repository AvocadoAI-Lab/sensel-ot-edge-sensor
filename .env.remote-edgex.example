# Lab profile: Ubuntu EdgeX -> local SenseL OT edge sensor -> Arista control plane.

SITE_ID=factory-lab-001
SENSOR_ID=ot-edge-001
SENSOR_TYPE=ot-edge-sensor

SENSEL_API_URL=http://host.docker.internal:8081
SENSEL_API_KEY=sensel-ot-ingest-lab-2026
SENSEL_VERIFY_TLS=false

EDGEX_CORE_DATA_URL=http://192.168.80.130:59880
EDGEX_SOURCE_HOST=192.168.80.130
EDGEX_BRIDGE_POLL_INTERVAL_SEC=5
EDGEX_BRIDGE_EVENT_LIMIT=20

NORTHBOUND_MQTT_ENABLED=true
CONTROL_PLANE_MQTT_HOST=host.docker.internal
CONTROL_PLANE_MQTT_PORT=1883
MQTT_TENANT_ID=default
MQTT_REQUIRE_TENANT=false

LOG_LEVEL=info
