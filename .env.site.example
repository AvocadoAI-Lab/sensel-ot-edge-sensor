SENSEL_SITE_ENV=production
SENSEL_SITE_TENANT_ID=tenant-a
SENSEL_SITE_ID=site-a
SENSEL_SITE_NODE_ID=site-node-a
SENSEL_SITE_MQTT_ENABLED=true
SENSEL_SITE_MQTT_SESSION_EXPIRY_SEC=86400
SENSEL_SITE_EPISODE_RETENTION_DAYS=30
SENSEL_SITE_MAX_EPISODE_BYTES=1048576
SENSEL_SITE_WORKER_MEMORY_LIMIT=2g
SENSEL_SITE_WORKER_CPU_LIMIT=2.0
SENSEL_SITE_RELEASE_MEMORY_LIMIT=256m
SENSEL_SITE_RELEASE_CPU_LIMIT=0.5
SENSEL_SITE_SIGNING_KEY_ID=site-a-ed25519-2026-01
SENSEL_SITE_TRAINER_SIGNING_KEY_ID=site-a-trainer-ed25519-2026-01
SENSEL_SITE_RELEASE_SIGNING_KEY_ID=site-a-release-ed25519-2026-01

# Host-side secret directories; never commit their contents.
SENSEL_SITE_MQTT_CERT_DIR=./secrets/site-mqtt
SENSEL_SITE_MQTT_ACL_FILE=./secrets/site-mqtt/site.acl
SENSEL_SITE_CLIENT_CERT_DIR=./secrets/site-client
SENSEL_SITE_SIGNING_DIR=./secrets/site-signing
SENSEL_SITE_PUBLIC_KEY_DIR=./secrets/site-public
SENSEL_SITE_TRAINER_SIGNING_DIR=./secrets/trainer-signing
SENSEL_SITE_TRAINER_PUBLIC_KEY_DIR=./secrets/trainer-public
SENSEL_SITE_RELEASE_SIGNING_DIR=./secrets/release-signing
# Passed explicitly to `make release-site`; the signer reads exactly one approval.
SENSEL_SITE_MANUAL_APPROVAL_FILE=./secrets/manual-approval/approval.json
