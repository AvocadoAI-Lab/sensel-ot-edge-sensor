# SenseL NDR Edge — local Snort 3 rules (starter set).
# Replace / extend with the SenseL OT rule pack or community rules.
# SIDs >= 1000000 are reserved for local rules per Snort convention.

# Detect unauthorized Modbus TCP access (OT example, mirrors PRD §13.1).
alert tcp any any -> any 502 ( msg:"SENSEL Modbus TCP access observed"; flow:to_server; sid:1000001; rev:1; priority:2; classtype:protocol-command-decode; )

# Detect TCP SYN port-scan-like behavior to common OT ports.
alert tcp any any -> any [102,502,20000,44818] ( msg:"SENSEL OT port probe"; flags:S; sid:1000002; rev:1; priority:2; classtype:attempted-recon; )
