# SenseL OT Edge Sensor — Main Configuration
# Copy to sensor.yaml (gitignored) and customize per deployment

sensor:
  # 留空或 ot-edge-001 時，agent 會依主機名稱自動產生唯一 ID
  id: ot-edge-001
  site_id: factory-lab-001
  type: ot-edge-sensor
  hardware: ubuntu  # ubuntu | raspberry-pi-4
  software_version: "0.1.0"
  capabilities:
    - edgex
    - modbus
    - mqtt
    - packet-capture
    - local-detection

sensel:
  api_url: ${SENSEL_API_URL}
  api_key: ${SENSEL_API_KEY}
  events:
    watch_path: /app/data/assets/security-events.jsonl
    offset_path: /app/data/security-events.offset
  episodes:
    watch_path: /app/data/assets/trust-episodes.jsonl
    offset_path: /app/data/trust-episodes.offset
    spool_db_path: /app/data/trust-episode-spool.db
    max_episodes: 2000
  upload:
    events_path: /api/v1/ot/security-events
    telemetry_path: /api/v1/ot/telemetry
    health_path: /api/v1/edge-sensors/health
    register_path: /api/v1/edge-sensors/register
  retry:
    max_attempts: 10
    backoff_sec: 30
  buffer:
    max_events: 1000
    db_path: /app/data/event-buffer.db

northbound_mqtt:
  enabled: false
  host: ""
  port: 1883
  tenant_id: default
  qos_events: 1
  tls: false
  tls_ca_path: ""
  tls_cert_path: ""
  tls_key_path: ""
  tls_insecure: false
  # json (default) → dual (shadow protobuf) → protobuf
  wire_mode: json
  protobuf_failure_threshold: 3
  rollback_state_path: /app/data/northbound-wire-state.json

# P2-A: EdgeX Core Metadata is the device-management registry. The agent is
# the only control-plane writer; packet capture and passive inventory continue
# independently if EdgeX is unavailable.
edgex_device_management:
  enabled: true
  metadata_url: http://edgex-core-metadata:59881
  request_timeout_sec: 5
  inventory_interval_sec: 60
  gateway_id: ""  # empty uses sensor.id
  live_observed_path: /app/data/assets/baseline/live-observed.json
  identity_inventory_path: /app/data/asset-inventory.json
  inventory_state_path: /app/data/edgex-inventory-state.json
  desired_state_path: /app/data/edgex-desired-state.json
  reconcile_state_path: /app/data/edgex-reconcile-state.json
  observed_spool_db_path: /app/data/edgex-observed-spool.db
  desired_mqtt_enabled: true
  sampling_profiles:
    disabled: ""
    slow: 60s
    standard: 10s
    fast: 1s

capture:
  interface: ${CAPTURE_INTERFACE}
  promiscuous: true
  # Lab 61850: (ether proto 0x88b8) or (tcp port 102)
  bpf_filter: ${CAPTURE_BPF_FILTER}
  timestamping: true
  health_check_interval_sec: 30

pcap:
  retention_minutes: 120
  max_disk_mb: 2048
  evidence_before_sec: 60
  evidence_after_sec: 60
  ring_buffer_path: /app/data/pcap

features:
  window_sec: 60
  contract_id: ot-window-v1
  contract_path: /app/config/model/feature-contract.ot-window-v1.json
  mqtt:
    host: ${LOCAL_MQTT_HOST}
    port: ${LOCAL_MQTT_PORT}
    topic_prefix: sensel/ot
    edgex_device_name: packet-sensor-features
    # edgex_data_topic:  # default → incoming/data/packet-sensor-features/FeatureSummary

# P1-B local ML is fail-open and disabled until real ONNX artifacts, exact
# SHA-256 digests, concrete model versions, and calibration are installed.
# Build packet-sensor with INSTALL_ML_RUNTIME=true before enabling this block.
inference:
  enabled: false
  episode_output_path: /app/data/assets/trust-episodes.jsonl
  runtime_status_path: /app/data/assets/model-runtime.json
  emit_decisions: [alert]
  fusion_policy_version: fusion-v1
  fusion_alert_threshold: 0.75
  fusion_maximum_weight: 0.7
  isolation_forest:
    enabled: false
    model_path: /app/data/models/isolation-forest.onnx
    model_version: unconfigured
    artifact_sha256: ""
    calibration_path: /app/config/model/calibration.json
  xgboost:
    enabled: false
    model_path: /app/data/models/xgboost.onnx
    model_version: unconfigured
    artifact_sha256: ""
    calibration_path: /app/config/model/calibration.json
    output_index: 1
  tiny_lstm:
    enabled: false
    model_path: /app/data/models/tiny-lstm.onnx
    model_version: unconfigured
    artifact_sha256: ""
    calibration_path: /app/config/model/calibration.json

detection:
  policy_file: /app/config/policy/baseline.json
  rules_enabled:
    - OT-001
    - OT-002
    - OT-003
    - OT-004
    - OT-005
    - OT-006
    - OT-007
    - OT-008
    - OT-009
    - OT-010
    - OT-011
    - OT-012
    - OT-013
    - OT-014
    - OT-016
    - OT-018
    - OT-019
  latency_target_sec: 3

# CTI IoC match (Track B-S2) — reads edge-agent ioc-cache via shared volume
ioc:
  enabled: true
  cache_path: /app/data/agent/ioc-cache.json
  stamp_path: /app/data/agent/ioc-cache.stamp
  cooldown_sec: 300
  reload_check_sec: 5

edgex:
  enabled: true
  mqtt_broker: edgex-mqtt-broker:1883

logging:
  level: info
  format: json
