# =============================================================================
# SenseL NDR Edge — OpenWrt environment (copy to .env)
# Minimal set for an OpenWrt host running the edge sensor (Mode A).
# =============================================================================

# --- Identity ---
SITE_ID=site-openwrt-001
SENSOR_ID=ndr-edge-owrt-001
SENSOR_TYPE=ot-edge-sensor

# --- SenseL / Control Plane uplink ---
SENSEL_API_URL=https://your-sensel-instance.example.com
SENSEL_API_KEY=your-api-key-here
SENSEL_VERIFY_TLS=true

# Northbound MQTT (primary event uplink)
NORTHBOUND_MQTT_ENABLED=true
CONTROL_PLANE_MQTT_HOST=192.168.1.203
CONTROL_PLANE_MQTT_PORT=1883
MQTT_TENANT_ID=default

# --- Capture ---
# Dedicated mirror/monitor port (NOT the LAN/WAN bridge). See the guide for
# setting up port mirroring on DSA / swconfig OpenWrt.
CAPTURE_INTERFACE=eth1
# Narrow the filter to the OT protocols you care about to save CPU, e.g.:
# CAPTURE_BPF_FILTER=(tcp port 502) or (tcp port 102) or (ether proto 0x88b8)
CAPTURE_BPF_FILTER=
CAPTURE_MAX_MBPS=100

# --- External storage for PCAP (extroot / USB / SSD mount) ---
# Point DATA_DIR at a real disk; do NOT use internal flash for PCAP.
# Example: DATA_DIR=/mnt/sensel
DATA_DIR=./data
PCAP_MAX_DISK_MB=512
PCAP_RETENTION_MINUTES=30

# --- Track B: CTI policy sync + sighting (optional) ---
POLICY_SYNC_ENABLED=true
SMB_INTEL_API_KEY=
IOC_MATCH_ENABLED=true
SIGHTING_REPORT_ENABLED=true

# --- Optional external engines (enable only on x86 appliances >=4 GB RAM) ---
# Snort  (with -f docker-compose.snort.yml):    SNORT_INTERFACE / SNORT_CTI_SID_MIN/MAX
# Suricata (with -f docker-compose.suricata.yml): SURICATA_INTERFACE / shared CTI SID range

# --- Logging / hardware profile ---
LOG_LEVEL=info
DEPLOY_TARGET=openwrt
