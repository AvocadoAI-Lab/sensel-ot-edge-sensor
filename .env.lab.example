# Lab-only secrets for ./scripts/deploy-ot-lab.sh --sprint4 / verify-sprint4-lab.sh
# Copy to .env.lab (gitignored) and fill in values.
#
# cp .env.lab.example .env.lab

# SSH (108/203 default lab password)
# SSHPASS=avocado@@

# Pi SSH (lab profile)
# PI_SSHPASS=edgex

# Portal JWT for S5-E1 / S5-G1 (SMB /ot-security/* routes)
# PORTAL_BEARER_TOKEN=
PORTAL_EMAIL=
PORTAL_PASSWORD=
WORKSPACE_ID=6

# Track B (optional gate with --track-b)
# SMB_INTEL_API_KEY=
# POLICY_SYNC_TENANT_ID=sensel-platform

# Pi registration
# OT_REGISTRATION_TOKEN=
