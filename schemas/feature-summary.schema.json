{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sensel.io/schemas/ot/feature-summary.json",
  "title": "OT Feature Summary (1-minute window)",
  "type": "object",
  "required": ["sensor_id", "site_id", "window", "timestamp"],
  "properties": {
    "sensor_id": { "type": "string" },
    "site_id": { "type": "string" },
    "window": { "type": "string" },
    "src_mac": { "type": "string" },
    "src_ip": { "type": "string" },
    "dst_ip": { "type": "string" },
    "protocol": { "type": "string" },
    "feature_contract_id": { "type": "string" },
    "port": { "type": "integer" },
    "packet_count": { "type": "integer" },
    "packet_rate": { "type": "number" },
    "unique_mac_count": { "type": "integer" },
    "byte_count": { "type": "integer" },
    "modbus_read_count": { "type": "integer" },
    "modbus_write_count": { "type": "integer" },
    "goose_appid": { "type": "integer" },
    "goose_gocb_ref": { "type": "string" },
    "goose_publisher_mac": { "type": "string" },
    "goose_message_count": { "type": "integer" },
    "goose_stnum_changes": { "type": "integer" },
    "goose_test_flag_count": { "type": "integer" },
    "goose_unique_publishers": { "type": "integer" },
    "mms_session_count": { "type": "integer" },
    "mms_read_count": { "type": "integer" },
    "mms_write_count": { "type": "integer" },
    "mms_report_count": { "type": "integer" },
    "ied_address": { "type": "string" },
    "new_connection_count": { "type": "integer" },
    "risk_score": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
